---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <h1>Page not found</h1>

  <div class="prose">
    <p>
      That address doesn't match anything here. It may have been a note or a
      stash entry — neither of those has a page of its own, so a link to one
      lands on its feed rather than a permalink.
    </p>

    <p>
      The <a href="/sitemap">sitemap</a> lists everything on the site, or you
      can start from the <a href="/">homepage</a>.
    </p>
  </div>
</Base>
