---
import Base from '../../layouts/Base.astro';
import WritingPreview from '../../components/WritingPreview.astro';
import FacetFilter from '../../components/FacetFilter.astro';
import { getWriting, getTagsInUse, tagSlugs } from '../../lib/content';
import { tagFacet } from '../../lib/facets';

const posts = await getWriting();
const tags = await getTagsInUse(posts);

// One facet here. The same script drives /stash with five — see §4.5.
const groups = [tagFacet(tags)];
---

<Base
  title="Writing"
  description="Articles on design systems, accessibility, and building for the web."
>
  <h1>Writing</h1>

  <FacetFilter groups={groups} />

  <!--
    role="status" announces changes politely to screen readers without moving
    focus. Filtering is otherwise a silent visual change — items just vanish —
    which leaves a non-sighted user with no idea anything happened.
  -->
  <p data-filter-status role="status" aria-live="polite" hidden></p>

  {
    posts.length > 0 ? (
      <>
        <ul role="list" data-filterable-list data-filter-noun="post">
          {posts.map((entry) => (
            <li data-facet-tag={tagSlugs(entry)}>
              <WritingPreview entry={entry} headingLevel={2} />
            </li>
          ))}
        </ul>

        <p data-filter-empty hidden>No posts match those filters.</p>
      </>
    ) : (
      <p>Nothing published yet.</p>
    )
  }
</Base>

<script>
  import '../../scripts/facet-filter';
</script>
