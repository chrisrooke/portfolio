---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import {
  getInternalWriting,
  getWritingSeriesIndex,
  projectHref,
  resolveTags,
  type WritingEntry,
} from '../../lib/content';

/**
 * Only internal posts get a page. External link-posts live in the same
 * collection but are filtered out here, so no empty route is generated for
 * them — see docs/content-architecture.md §3.3.
 */
export async function getStaticPaths() {
  const posts = await getInternalWriting();
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tags = await resolveTags(entry);

/*
 * Derived, not stored: the post declares no series and no part number. Its
 * position comes from the ordered array on whichever project lists it, so the
 * two can never disagree. See docs/content-architecture.md §4.3.
 */
const series = (await getWritingSeriesIndex()).get(entry.id);
---

<Post
  title={entry.data.title}
  intro={entry.data.intro}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  cover={entry.data.cover}
  coverAlt={entry.data.coverAlt}
  tags={tags}
>
  {
    series && (
      <p slot="meta">
        {series.total > 1 ? `Part ${series.part} of ${series.total} in ` : 'Written for '}
        <a href={projectHref(series.project)}>{series.project.data.title}</a>
      </p>
    )
  }

  <Content />
</Post>
