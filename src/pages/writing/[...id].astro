---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getInternalWriting, resolveTags, type WritingEntry } from '../../lib/content';

/**
 * Only internal posts get a page. External link-posts live in the same
 * collection but are filtered out here, so no empty route is generated for
 * them — see docs/content-architecture.md §3.3.
 */
export async function getStaticPaths() {
  const posts = await getInternalWriting();
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const tags = await resolveTags(entry);
---

<Post
  title={entry.data.title}
  intro={entry.data.intro}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  cover={entry.data.cover}
  coverAlt={entry.data.coverAlt}
  tags={tags}
>
  <Content />
</Post>
