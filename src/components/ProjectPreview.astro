---
import { getImage } from 'astro:assets';
import { projectHref, type ProjectEntry } from '../lib/content';
import { coverImageProps } from '../lib/images';

interface Props {
  entry: ProjectEntry;
  /** Matches WritingPreview: previews sit under different parents. Defaults to h2. */
  headingLevel?: 2 | 3 | 4;
}

const { entry, headingLevel = 2 } = Astro.props;

const { title, intro, cover, coverAlt, role, year, tech } = entry.data;
const href = projectHref(entry);

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';

/**
 * PLACEHOLDER — revisit with the responsive layout, like Post.astro's.
 * Projects lead the homepage, so these covers are the heaviest assets on the
 * site and the numbers matter more here than anywhere else. Guessed against a
 * two-up card grid that does not exist yet.
 */
const CARD_WIDTHS = [400, 800, 1200];
const CARD_SIZES = '(min-width: 60rem) 30rem, 100vw';

/**
 * getImage + a plain <img> rather than <Image>, which always infers `width` and
 * `height` from the file. Those attributes give the element an implicit
 * aspect-ratio that CSS then has to fight; sizing here is the stylesheet's job.
 * Note the tradeoff: without them the card reflows once the cover decodes.
 */
const coverImage = cover
  ? await getImage({ src: cover, ...coverImageProps(cover, CARD_WIDTHS, CARD_SIZES) })
  : undefined;
---

<article>
  <a href={href} class="card">
    <img src="" class="card__icon"/>

    <Heading>
      <!-- Title-only link, matching WritingPreview: a card-wide anchor makes the
          text unselectable and announces the whole block as one link name. -->
      {title}
    </Heading>

    <p>{intro}</p>

    <!-- {
      (role || year) && (
        <p>
          {role}
          {role && year && ' · '}
          {year}
        </p>
      )
    } -->

    <!-- {
      tech.length > 0 && (
        <ul role="list" aria-label="Built with">
          {tech.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    } -->

    {
      coverImage && (
        <img
          src={coverImage.src}
          srcset={coverImage.srcSet.attribute || undefined}
          sizes={coverImage.srcSet.attribute ? CARD_SIZES : undefined}
          alt={coverAlt ?? ''}
          loading="lazy"
          decoding="async"
          class="card__cover"
        />
      )
    }

  </a>
</article>
