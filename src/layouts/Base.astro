---
import '../styles/global.css';

interface Props {
  /** Page title. Rendered as-is in <title>, suffixed with the site name. */
  title: string;
  /** Meta description. Optional, but worth setting on every real page. */
  description?: string;
}

const { title, description } = Astro.props;

const siteName = 'Chris Rooke';

// Astro.site is undefined until `site` is set in astro.config.mjs.
// Canonical URLs and RSS both need it — see docs/content-architecture.md.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/notes', label: 'Notes' },
  { href: '/stash', label: 'Stash' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === siteName ? title : `${title} — ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteName} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
  </head>

  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>

    <header>
      <a href="/" rel="home">{siteName}</a>
      <nav aria-label="Primary">
        <ul role="list">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={path === href || path.startsWith(`${href}/`) ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} {siteName}</p>
      <p><a href="/colophon">Colophon</a></p>
    </footer>
  </body>
</html>
