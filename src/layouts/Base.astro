---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Page title. Rendered as-is in <title>, suffixed with the site name. */
  title: string;
  /** Meta description. Optional, but worth setting on every real page. */
  description?: string;
  /** Extra class(es) for <main>, for page-specific layout. */
  className?: string;
  /**
   * Social card image. Falls back to the site-wide card. Pass an entry's
   * cover where there is one — a post shared with its own artwork looks
   * considerably less generic than one shared with the default.
   */
  image?: ImageMetadata;
  /** og:type. "article" for anything with a publish date. */
  type?: 'website' | 'article';
}

const { title, description, className, image, type = 'website' } = Astro.props;

const siteName = 'Chris Rooke';

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

/*
 * og:image is one of the few places an SVG is not acceptable — most platforms
 * refuse to render one — so a raster is required either way.
 *
 * The default card lives in public/ rather than going through the image
 * pipeline, which looks like a violation of the §5 rule but isn't: that rule
 * exists for images needing resizing, format conversion and intrinsic
 * dimensions. A social card is a fixed 1200×630 referenced by absolute URL and
 * needs none of those. Rasterising it through the pipeline instead would mean
 * enabling `image.dangerouslyProcessSVG`, which is global and would change how
 * every content cover is handled — a large blast radius for one static file.
 * The SVG source is kept in src/assets/ and regenerated with sharp; see the
 * colophon.
 *
 * A page's own cover is used when it has one, since a post shared with its own
 * artwork looks considerably less generic. SVG covers fall back to the default
 * for the same reason as above. `fit: 'cover'` matters here: covers are
 * landscape or portrait at various ratios, and without it a book jacket would
 * be squashed into 1200×630.
 */
const ogPath =
  image && image.format !== 'svg'
    ? (
        await getImage({
          src: image,
          format: 'png',
          width: 1200,
          height: 630,
          fit: 'cover',
        })
      ).src
    : '/og-default.png';

const ogUrl = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/notes', label: 'Notes' },
  { href: '/stash', label: 'Stash' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === siteName ? title : `${title} — ${siteName}`}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/*
      Both feeds are advertised. Readers that autodiscover offer a choice, and
      the titles have to say which is which — two entries both called "Chris
      Rooke" would be a coin toss.
    */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} — everything`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} — writing and projects`}
      href="/articles.xml"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content={siteName} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav__wrap">
      <div class="nav__grid">
        <a href="/" rel="home" class="button nav__button--home">{siteName.split(' ').map((part, i) => (i ? <><br />{part}</> : part))}</a>
        <button command="show-modal" commandfor="nav__mobile"><span>Menu</span></button>
      </div>
      <dialog id="nav__mobile" class="nav__wrap">
        <div class="nav__grid">
          <a href="/" rel="home" class="nav__button nav__button--home">{siteName.split(' ').map((part, i) => (i ? <><br />{part}</> : part))}</a>
          <button command="close" commandfor="nav__mobile" class="button__icon"><span>Close menu</span></button>
        </div>
        <nav aria-label="Primary">
          <ul role="list">
            {
              nav.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    aria-current={path === href || path.startsWith(`${href}/`) ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </dialog>
      <!-- <nav aria-label="Primary">
        <ul role="list">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={path === href || path.startsWith(`${href}/`) ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav> -->
    </header>

    <main id="main" class={className}>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} {siteName}</p>
      <a href="/sitemap">Sitemap</a>
      <a href="/colophon">Colophon</a>
      <p><a href="/rss.xml">RSS</a> <small>(<a href="/articles.xml">long-form only</a>)</small></p>
    </footer>
  </body>
</html>
