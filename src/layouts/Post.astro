---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from './Base.astro';
import { formatDate, machineDate } from '../lib/format';
import { coverImageProps } from '../lib/images';

/**
 * The long-form layout, shared by writing posts and project case studies.
 *
 * Two optional named slots keep it shared rather than forked:
 * - `meta`     — in the header. Project facts and links out; on a writing post,
 *                the "part n of m" line.
 * - `related`  — after the body. Onward navigation, outside the prose.
 *
 * Both render nothing when unfilled, so a plain writing post is unaffected.
 */
interface Props {
  /**
   * Which content type is rendering. Drives the title class only — the two
   * types share every other part of this header. Required rather than
   * defaulted, so a new caller has to say which it is.
   *
   * When the types diverge structurally rather than stylistically, the seam to
   * reach for is a slot (as `meta` already is), not a second copy of this file.
   */
  kind: 'writing' | 'project';
  title: string;
  intro: string;
  publishDate: Date;
  updatedDate?: Date;
  cover?: ImageMetadata;
  coverAlt?: string;
  tags?: { id: string; data: { name: string } }[];
}

const { kind, title, intro, publishDate, updatedDate, cover, coverAlt, tags = [] } =
  Astro.props;

const titleClass = kind === 'project' ? 'head--project' : 'head--article';

/**
 * PLACEHOLDER — revisit once the responsive layout exists.
 * See docs/content-architecture.md §5 "Revisit: widths and sizes".
 *
 * These numbers predate any design. `sizes` must match the width the cover is
 * actually drawn at, and the ceiling of `COVER_WIDTHS` should be roughly that
 * width x2 to serve retina screens sharply. Both fail silently when wrong:
 * too-small `sizes` renders soft, too-large wastes bandwidth on every visit.
 * The vector guard lives in coverImageProps().
 */
const COVER_WIDTHS = [480, 800, 1200];
const COVER_SIZES = '(min-width: 60rem) 60rem, 100vw';

/**
 * getImage + a plain <img> rather than <Image>, which always infers `width` and
 * `height` from the file. Those attributes give the element an implicit
 * aspect-ratio that CSS then has to fight; sizing here is the stylesheet's job.
 * Note the tradeoff: without them the cover reflows once it decodes. Matches
 * ProjectPreview.astro.
 */
const coverImage = cover
  ? await getImage({ src: cover, ...coverImageProps(cover, COVER_WIDTHS, COVER_SIZES) })
  : undefined;
---

{/*
  The cover doubles as the social card where there is one, and everything
  through this layout has a publish date, so og:type is always "article".
*/}
<Base title={title} description={intro} image={cover} type="article">
  <article class="card">
    <header>
      <img src="" class="article__icon"/>
      <h1 class={titleClass}>{title}</h1>
      <p>{intro}</p>

      {
        coverImage && (
          <img
            src={coverImage.src}
            srcset={coverImage.srcSet.attribute || undefined}
            sizes={coverImage.srcSet.attribute ? COVER_SIZES : undefined}
            alt={coverAlt ?? ''}
            class="article__hero"
          />
        )
      }

      <div class="meta__wrap">

        <p class="para--meta">
          <time datetime={machineDate(publishDate)}>{formatDate(publishDate)}</time>
          {
            updatedDate && (
              <>
                {' · updated '}
                <time datetime={machineDate(updatedDate)}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>

        {
          tags.length > 0 && (
            <ul class="list--meta" role="list" aria-label="Tags">
              {tags.map((tag) => (
                <li class="para--meta">{tag.data.name}</li>
              ))}
            </ul>
          )
        }

        <!-- <slot name="meta" /> -->
      </div>

    </header>

    <div class="prose">
      <slot />
    </div>

    <slot name="related" />
  </article>
</Base>
