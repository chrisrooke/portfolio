---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import { formatDate, machineDate } from '../lib/format';
import { coverImageProps } from '../lib/images';

/**
 * The long-form layout, shared by writing posts and project case studies.
 *
 * Two optional named slots keep it shared rather than forked:
 * - `meta`     — in the header. Project facts and links out; on a writing post,
 *                the "part n of m" line.
 * - `related`  — after the body. Onward navigation, outside the prose.
 *
 * Both render nothing when unfilled, so a plain writing post is unaffected.
 */
interface Props {
  title: string;
  intro: string;
  publishDate: Date;
  updatedDate?: Date;
  cover?: ImageMetadata;
  coverAlt?: string;
  tags?: { id: string; data: { name: string } }[];
}

const { title, intro, publishDate, updatedDate, cover, coverAlt, tags = [] } =
  Astro.props;

/**
 * PLACEHOLDER — revisit once the responsive layout exists.
 * See docs/content-architecture.md §5 "Revisit: widths and sizes".
 *
 * These numbers predate any design. `sizes` must match the width the cover is
 * actually drawn at, and the ceiling of `COVER_WIDTHS` should be roughly that
 * width x2 to serve retina screens sharply. Both fail silently when wrong:
 * too-small `sizes` renders soft, too-large wastes bandwidth on every visit.
 * The vector guard lives in coverImageProps().
 */
const COVER_WIDTHS = [480, 800, 1200];
const COVER_SIZES = '(min-width: 60rem) 60rem, 100vw';
---

<Base title={title} description={intro}>
  <article>
    <header>
      <h1>{title}</h1>
      <p>{intro}</p>

      <p>
        <time datetime={machineDate(publishDate)}>{formatDate(publishDate)}</time>
        {
          updatedDate && (
            <>
              {' · updated '}
              <time datetime={machineDate(updatedDate)}>{formatDate(updatedDate)}</time>
            </>
          )
        }
      </p>

      {
        tags.length > 0 && (
          <ul role="list" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag.data.name}</li>
            ))}
          </ul>
        )
      }

      <slot name="meta" />

      {
        cover && (
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            {...coverImageProps(cover, COVER_WIDTHS, COVER_SIZES)}
          />
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <slot name="related" />
  </article>
</Base>
